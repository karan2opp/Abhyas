# Copy to `.env.local` for local development, and enter the same name in Vercel (Settings > Environment Variables).
# The value is baked in when the site is built, so redeploy after changing it.

# The API's address plus /api, with nothing after it.
#   local:       http://localhost:8000/api
#   production:  https://YOUR-SERVER.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
